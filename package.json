{
  "name": "trading-research",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "deps:install": "pnpm install --frozen-lockfile",
    "data:analyze": "python3 scripts/research.py analyze",
    "backtest": "python3 scripts/research.py run",
    "api": "python3 scripts/research.py serve",
    "cloud:install": "pnpm install --frozen-lockfile",
    "cloud:start": "python3 --version",
    "dev:tailscale": "node scripts/tailscale-dev.mjs start",
    "dev:tailscale:status": "node scripts/tailscale-dev.mjs status",
    "dev:tailscale:stop": "node scripts/tailscale-dev.mjs stop"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  }
}
